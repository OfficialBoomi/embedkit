# =========================================================================
# @boomi/embedkit — .env.example
# Used by the local Vite dev harness (index.html + index.js).
# Anything prefixed VITE_ is bundled into the browser, so use throwaway
# tokens here, never production secrets.
# =========================================================================

# -------- EmbedKit server --------
# Local server (see ../embedkit-server). Use https://api.boomi.space/api/v1 to
# point at production.
VITE_EMBEDKIT_SERVER_BASE=http://localhost:8081/api/v1

# -------- Boomi Platform credentials (admin login flow) --------
VITE_API_URL=https://api.boomi.com/partner/api/rest/v1
VITE_API_ACCOUNT_ID=your-parent-account-id
VITE_API_USERNAME=BOOMI_TOKEN.you@boomi.com
VITE_API_TOKEN=your-boomi-api-token
VITE_API_AUTH_USER=your-child-account-id-or-blank
VITE_API_ACCOUNT_GROUP=your-account-group-or-blank
VITE_APP_EN=development

# -------- AI features --------
# Required if boomi.config.js sets enableAi: true
VITE_OPENAI_API_KEY=sk-your-openai-key

# -------- OAuth2 connectors (optional) --------
VITE_QUICKBOOKS_OAUTH_CLIENT_ID=
VITE_QUICKBOOKS_OAUTH_CLIENT_SECRET=

# -------- Test fixtures (optional) --------
# Used by integration tests in tests/
TEST_USER=
TEST_TOKEN=
TEST_ACCOUNT_ID=
TEST_AGENT_ID=
